# Copy to /etc/jenkins-weekly-maintenance.env and chmod 600.
# Use a dedicated Jenkins admin account and API token; do not commit real secrets.
JENKINS_URL=http://127.0.0.1:8080
JENKINS_USER=maintenance-admin
JENKINS_API_TOKEN=REPLACE_WITH_JENKINS_API_TOKEN
JENKINS_HEALTH_URL=http://127.0.0.1:8080/login
JENKINS_HOME=/var/lib/jenkins

# Gmail SMTP: use a Google App Password, not your regular Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
SMTP_FROM=your-address@gmail.com
SMTP_TO=your-address@gmail.com
