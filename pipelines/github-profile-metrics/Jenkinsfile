pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 45, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    environment {
        INFLUX_URL = 'https://us-east-1-1.aws.cloud2.influxdata.com'
        INFLUX_BUCKET = 'qa_metrics'
        INFLUX_DATABASE = 'qa_metrics'
        INFLUX_RETENTION_POLICY = 'autogen'
        PYTHONUNBUFFERED = '1'
    }

    stages {
        stage('Checkout pipeline repository') {
            steps {
                checkout scm
            }
        }

        stage('Checkout CI configuration') {
            steps {
                dir('ci-config') {
                    git branch: 'main',
                        url: 'https://github.com/SanthoshJeeva440/automation-ci-config.git'
                }

                script {
                    def config = readYaml file: 'ci-config/github-profile-metrics/config.yml'

                    env.GITHUB_METRICS_REPO_URL = config.project.runner_repository
                    env.GITHUB_METRICS_REPO_BRANCH = config.project.runner_branch ?: 'main'
                    env.GITHUB_METRICS_CRON = config.jenkins.cron ?: 'H 7 * * *'

                    properties([
                        pipelineTriggers([
                            cron(env.GITHUB_METRICS_CRON)
                        ])
                    ])

                    echo "Daily schedule configured: ${env.GITHUB_METRICS_CRON}"
                }
            }
        }

        stage('Checkout Grafana metrics repository') {
            steps {
                dir('automation-grafana') {
                    git branch: env.GITHUB_METRICS_REPO_BRANCH,
                        url: env.GITHUB_METRICS_REPO_URL

                    // Validate files from inside automation-grafana
                    sh '''
                        set -eu

                        echo "Checking GitHub metrics runner..."

                        if [ ! -f runners/github_profile_metrics_runner.py ]; then
                            echo "ERROR: GitHub metrics runner not found!"
                            exit 1
                        fi

                        if [ ! -f requirements.txt ]; then
                            echo "ERROR: requirements.txt not found!"
                            exit 1
                        fi

                        if [ ! -f integrations/influxdb_writer.py ]; then
                            echo "ERROR: integrations/influxdb_writer.py not found!"
                            exit 1
                        fi

                        echo "All required files are available."
                    '''
                }
            }
        }

        stage('Install dependencies') {
            steps {
                dir('automation-grafana') {
                    sh '''
                        set -eu

                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt
                        .venv/bin/pip install PyYAML

                        echo "Dependencies installed successfully."
                    '''
                }
            }
        }

        stage('Collect GitHub profile and repository metrics') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-read-token',
                        variable: 'GITHUB_TOKEN'
                    ),
                    string(
                        credentialsId: 'influx-cloud-token',
                        variable: 'INFLUX_TOKEN'
                    )
                ]) {
                    script {
                        def config = readYaml file: 'ci-config/github-profile-metrics/config.yml'

                        withEnv([
                            "GITHUB_USERNAME=${config.github.username}",
                            "GITHUB_INCLUDE_FORKS=${config.collection.include_forks}",
                            "GITHUB_INCLUDE_ARCHIVED=${config.collection.include_archived}",
                            "GITHUB_MAX_REPOSITORIES=${config.collection.max_repositories}",
                            "GITHUB_METRICS_MEASUREMENT_PREFIX=${config.influxdb.measurement_prefix}"
                        ]) {
                            dir('automation-grafana') {
                                sh '''
                                    set -eu

                                    echo "Starting GitHub metrics collection..."

                                    .venv/bin/python runners/github_profile_metrics_runner.py

                                    echo "GitHub metrics collection completed."
                                '''
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'automation-grafana/github_metrics_report.json',
                allowEmptyArchive: true
            )
        }

        failure {
            script {
                def configPath = 'ci-config/github-profile-metrics/config.yml'

                if (fileExists(configPath)) {
                    def config = readYaml file: configPath

                    if (config?.notifications?.email?.enabled &&
                        config?.notifications?.email?.send_failure_alert &&
                        config?.notifications?.email?.to?.trim()) {

                        emailext(
                            to: config.notifications.email.to,
                            subject: "[GitHub Metrics] FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                            body: """
                                GitHub profile metrics collection failed.

                                Job: ${env.JOB_NAME}
                                Build: #${env.BUILD_NUMBER}

                                Review console output:
                                ${env.BUILD_URL}console
                            """,
                            attachLog: true
                        )
                    }
                }
            }
        }
    }
}
