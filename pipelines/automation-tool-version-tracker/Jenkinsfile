pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 30, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }
    environment {
        INFLUX_URL = 'https://us-east-1-1.aws.cloud2.influxdata.com'
        INFLUX_BUCKET = 'qa_metrics'
        INFLUX_DATABASE = 'qa_metrics'
        INFLUX_RETENTION_POLICY = 'autogen'
        PYTHONUNBUFFERED = '1'
    }
    stages {
        stage('Checkout pipeline repository') {
            steps { checkout scm }
        }
        stage('Checkout CI configuration') {
            steps {
                dir('ci-config') {
                    git branch: 'main', url: 'https://github.com/SanthoshJeeva440/automation-ci-config.git'
                }
                script {
                    def config = readYaml file: 'ci-config/automation-tool-version-tracker/config.yml'
                    env.TRACKER_REPO_URL = config.project.runner_repository
                    env.TRACKER_REPO_BRANCH = config.project.runner_branch ?: 'main'
                    env.TRACKER_CRON = config.jenkins.cron ?: 'H 8 * * 5'
                    properties([pipelineTriggers([cron(env.TRACKER_CRON)])])
                }
            }
        }
        stage('Checkout Grafana tracker') {
            steps {
                dir('automation-grafana') {
                    git branch: env.TRACKER_REPO_BRANCH, url: env.TRACKER_REPO_URL
                }
                sh """
                    set -eu
                    test -f "ci-config/automation-tool-version-tracker/tools.json"
                    mkdir -p automation-grafana/config
                    cp "ci-config/automation-tool-version-tracker/tools.json" automation-grafana/config/tools.json
                """
            }
        }
        stage('Install dependencies') {
            steps {
                dir('automation-grafana') {
                    sh """
                        set -eu
                        python3 -m venv .venv
                        . .venv/bin/activate
                        python -m pip install --upgrade pip
                        pip install -r requirements.txt
                    """
                }
            }
        }
        stage('Collect and compare versions') {
            steps {
                withCredentials([string(credentialsId: 'influx-cloud-token', variable: 'INFLUX_TOKEN')]) {
                    dir('automation-grafana') {
                        sh """
                            set -eu
                            . .venv/bin/activate
                            python runners/automation_tool_version_runner.py
                        """
                    }
                }
            }
        }
        stage('Email upgrade summary') {
            steps {
                script {
                    def config = readYaml file: 'ci-config/automation-tool-version-tracker/config.yml'
                    def report = readJSON file: 'automation-grafana/upgrade_report.json'
                    def emailEnabled = config?.notifications?.email?.enabled ?: false
                    def recipient = config?.notifications?.email?.to ?: ''
                    if (emailEnabled && recipient?.trim() && report.upgrades && report.upgrades.size() > 0) {
                        def rows = report.upgrades.collect { item ->
                            "- ${item.name} (${item.category}): ${item.previous_version} -> ${item.latest_version}\n  ${item.release_url}"
                        }.join('\n\n')
                        emailext(
                            to: recipient,
                            subject: "[Automation Version Tracker] ${report.upgrades.size()} upgrade(s) detected",
                            mimeType: 'text/plain',
                            body: "Stable automation-tool upgrades detected.\n\nChecked at (UTC): ${report.checked_at_utc}\nInfluxDB bucket: ${report.bucket}\n\n${rows}\n\nJenkins build: ${env.BUILD_URL}"
                        )
                    } else {
                        echo 'No upgrades detected or notifications are disabled; no upgrade email sent.'
                    }
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'automation-grafana/upgrade_report.json', allowEmptyArchive: true
        }
        failure {
            script {
                def configPath = 'ci-config/automation-tool-version-tracker/config.yml'
                if (fileExists(configPath)) {
                    def config = readYaml file: configPath
                    if (config?.notifications?.email?.enabled && config?.notifications?.email?.send_failure_alert && config?.notifications?.email?.to?.trim()) {
                        emailext(
                            to: config.notifications.email.to,
                            subject: "[Automation Version Tracker] FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                            body: "The automation-tool version tracker failed. Review console output: ${env.BUILD_URL}console",
                            attachLog: true
                        )
                    }
                }
            }
        }
    }
}
