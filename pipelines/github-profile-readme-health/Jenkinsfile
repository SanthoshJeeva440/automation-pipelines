pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    stages {
        stage('Checkout CI config') {
            steps {
                dir('ci-config') {
                    git branch: 'main', url: 'https://github.com/SanthoshJeeva440/automation-ci-config.git'
                }
                script {
                    if (!fileExists('ci-config/profile-readme-health/config.yml')) {
                        error('Missing ci-config/profile-readme-health/config.yml')
                    }
                    def cfg = readYaml file: 'ci-config/profile-readme-health/config.yml'
                    def schedule = cfg?.jenkins?.cron?.toString()?.trim()
                    if (!schedule) {
                        error('jenkins.cron must be set in profile-readme-health/config.yml')
                    }
                    properties([pipelineTriggers([cron(schedule)])])
                    echo "Configured schedule from YAML: ${schedule} (Jenkins controller timezone)"
                }
            }
        }

        stage('Check rendered profile README') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    command -v python3 >/dev/null || { echo 'python3 is required on this Jenkins agent'; exit 2; }
                    python3 -m venv .venv-profile-readme-health
                    .venv-profile-readme-health/bin/python -m pip install --disable-pip-version-check -r ci-config/profile-readme-health/requirements.txt
                    .venv-profile-readme-health/bin/python ci-config/profile-readme-health/check_profile.py \\
                      --config ci-config/profile-readme-health/config.yml \\
                      --report-dir reports
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
        }
        success {
            echo 'GitHub profile README health check passed. No email is sent on success.'
        }
        failure {
            echo 'GitHub profile README health check failed. Sending Gmail notification.'
            script {
                // Fallback keeps notification possible if the CI-config checkout itself failed.
                String recipient = 'santhoshjeeva440@gmail.com'
                String subjectPrefix = '[GitHub README Health Check]'
                String reportText = 'No health-check report was generated. Check the Jenkins console output.'

                try {
                    if (fileExists('ci-config/profile-readme-health/config.yml')) {
                        def cfg = readYaml file: 'ci-config/profile-readme-health/config.yml'
                        def emailCfg = cfg?.notifications?.email ?: [:]
                        if (emailCfg.enabled == false) {
                            echo 'Email notification disabled by YAML configuration.'
                            return
                        }
                        String configuredRecipient = emailCfg.to?.toString()?.trim()
                        if (configuredRecipient) {
                            recipient = configuredRecipient
                        }
                        String configuredPrefix = emailCfg.subject_prefix?.toString()?.trim()
                        if (configuredPrefix) {
                            subjectPrefix = configuredPrefix
                        }
                    }

                    if (fileExists('reports/profile-readme-health.md')) {
                        reportText = readFile('reports/profile-readme-health.md')
                        if (reportText.length() > 7000) {
                            reportText = reportText.take(7000) + '\n\n[Report truncated in email; open the archived report in Jenkins.]'
                        }
                    }

                    String subject = "${subjectPrefix} FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
                    String body = """GitHub profile README health check FAILED.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}

Report summary:
${reportText}

The full JSON/Markdown report, when generated, is archived with this Jenkins build.
"""

                    emailext(
                        to: recipient,
                        subject: subject,
                        body: body,
                        mimeType: 'text/plain',
                        attachmentsPattern: 'reports/profile-readme-health.md,reports/profile-readme-health.json'
                    )
                    echo "Failure email submitted to ${recipient}."
                } catch (Exception notificationError) {
                    // Keep the original test/build failure; report email-delivery problem in console.
                    echo "WARNING: Could not send failure email: ${notificationError.getMessage()}"
                }
            }
        }
    }
}
